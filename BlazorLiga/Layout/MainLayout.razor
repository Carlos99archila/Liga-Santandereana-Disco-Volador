@inherits LayoutComponentBase

<div class="page">
    <header class="header-content">
        <nav class="navbar navbar-expand-md site-navbar">
            <div class="container-fluid w-75">
                <!-- LOGO -->
                <a class="navbar-brand fw-bold" href="">
                    <img src="images/liga.png" class="brand-logo" />
                </a>
                <!-- BOTÓN HAMBURGUESA -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <!-- MENÚ -->
                <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
                    <NavMenu />
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO -->
    <main class="main-content">
        @Body
        <a href="https://www.instagram.com/discovoladorsantander/" target="_blank" rel="noopener noreferrer"
           class="instagram-float" aria-label="Visitar Instagram">
            <i class="bi bi-instagram"></i>
        </a>
    </main>

    <footer class="footer-content p-3">
        <div class="w-50 mx-auto gap-1 m-1">
            <div class="row">
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="images/fecodv.png" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="images/liga.png" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="gallery-item">
                        <img src="images/inder.png" />
                    </div>
                </div>
            </div>
            <p class="text-center m-1">Liga Santandereana de Disco Volador</p>
            <a href="mailto:discovoladorsantander@gmail.com" class="text-secondary d-flex justify-content-center align-items-center m-1">
                <i class="bi bi-envelope-at me-1"></i>
                discovoladorsantander@gmail.com
            </a>
            <p class="text-center m-1">&copy; Copyright 2027 - Todos los derechos reservados</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>